# ============================================================
# StudyBuddy AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your real .env to version control.
# ============================================================

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# JWT signing secret (required)
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret

# CORS — comma-separated list of allowed frontend origins (required)
# Local example:  http://localhost:3000
# Production:     https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Ollama base URL (optional — defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model names (optional — defaults shown below)
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB persistence directory (optional — defaults to ./chroma_data)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Upload directory for study material files (optional — defaults to <backend_root>/uploads)
# On cloud hosts with ephemeral filesystems, point this at a persistent volume.
UPLOAD_DIRECTORY=
